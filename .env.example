# Documentation only: set these as process environment variables.
# RepoFix-Lab does not automatically load this file.
REPOFIX_DATA_DIR=.repofix
REPOFIX_API_KEY=
REPOFIX_BASE_URL=https://api.openai.com/v1
REPOFIX_MODEL=
# Optional explicit HTTP(S) proxy for model requests; ambient proxies are ignored.
REPOFIX_PROXY_URL=
REPOFIX_SANDBOX_IMAGE=repofix-sandbox:0.1
REPOFIX_SANDBOX_TIMEOUT=30
